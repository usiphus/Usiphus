{
  "schema_version": 1,
  "inputs": {
    "cards": "../source-artifacts/cards.json",
    "curriculum": "../source-artifacts/curriculum.json",
    "mapping": "../source-artifacts/mapping.json",
    "evidence": "../source-artifacts/evidence.json",
    "learner_progress": "../source-artifacts/learner_progress.json",
    "cohort_analytics": "../source-artifacts/cohort_analytics.json",
    "review_schedule": "../source-artifacts/review_schedule.csv"
  },
  "output_dir": "../build/usiphus-v16",
