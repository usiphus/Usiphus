{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/usiphus/Usiphus/blob/main/schemas/generated-deck.schema.json",
  "title": "Usiphus Generated Medical Education Deck",
  "description": "Structural contract for generated_cards.json. Passing this schema is not clinical or examination approval.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "specialty",
    "cards"
  ],
  "properties": {
    "specialty": {
      "type": "string",
      "minLength": 1
    },
    "learner_level": {
      "type": "string"
    },
    "generation_notice": {
      "type": "string"
    },
    "cards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "card_id",
          "specialty",
          "prompt",
          "answer",
          "card_type",
          "difficulty",
          "learning_objective",
          "tags",
          "evidence_status"
        ],
        "properties": {
          "card_id": {
            "type": "string",
            "minLength": 1
          },
          "specialty": {
            "type": "string",
            "minLength": 1
          },
          "topic_id": {
            "type": "string",
            "minLength": 1
          },
          "domain_id": {
            "type": "string"
          },
          "curriculum_domain": {
            "type": "string"
          },
          "card_type": {
            "type": "string",
            "enum": [
              "basic",
              "mcq",
              "clinical_case",
              "viva",
              "osce"
            ]
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "beginner",
              "intermediate",
              "advanced"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 12,
            "maxLength": 500
          },
          "answer": {
            "type": "string",
            "minLength": 15,
            "maxLength": 5000
          },
          "options": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "correct_option": {
            "type": "string"
          },
          "learning_objective": {
            "type": "string",
            "minLength": 1
          },
          "tags": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "references": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "cognitive_level": {
            "type": "string",
            "enum": [
              "remember",
              "understand",
              "apply",
              "analyze",
              "evaluate",
              "create"
            ]
          },
          "exam_domain": {
            "type": "string"
          },
          "rubric": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "evidence_status": {
            "type": "string",
            "enum": [
              "unreviewed",
              "reviewed",
              "needs_update",
              "not_applicable"
            ]
          },
          "evidence_mapping_status": {
            "type": "string"
          },
          "evidence_claims": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": true,
              "required": [
                "claim_id",
                "text",
                "source_id",
                "snippet_id",
                "locator"
              ],
              "properties": {
                "claim_id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "source_id": {
                  "type": "string",
                  "minLength": 1
                },
                "snippet_id": {
                  "type": "string",
                  "minLength": 1
                },
                "locator": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          },
          "reviewer": {
            "type": "string"
          },
          "reviewed_on": {
            "type": "string",
            "format": "date"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "card_type": {
                  "const": "mcq"
                }
              },
              "required": [
                "card_type"
              ]
            },
            "then": {
              "required": [
                "options",
                "correct_option"
              ],
              "properties": {
                "options": {
                  "minItems": 4,
                  "maxItems": 5
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "card_type": {
                  "const": "osce"
                }
              },
              "required": [
                "card_type"
              ]
            },
            "then": {
              "required": [
                "rubric"
              ],
              "properties": {
                "rubric": {
                  "minItems": 3
                }
              }
            }
          }
        ]
      }
    }
  }
}
