index 0000000..9db6c43
--- /dev/null
+++ b/guideline_sources.py
@@ -0,0 +1,155 @@
+#!/usr/bin/env python3
+"""Discover clinical practice guideline citations through the official NCBI PubMed API.
+
+PubMed is a discovery/indexing source, not the issuing guideline publisher. This module
+imports citation metadata and abstracts only. It deliberately does not manufacture
+recommendation statements or strength grades from abstracts.
+"""
+from __future__ import annotations
+
+import argparse
+import datetime as dt
+import json
+import re
+import sys
+import urllib.parse
+import xml.etree.ElementTree as ET
+from pathlib import Path
+from typing import Callable
+
+from specialty_harvest import http_get
+
+EUTILS = "https://eutils.ncbi.nlm.nih.gov/entrez/eutils"
+USER_AGENT = "ANKI-clinical-guideline-discovery/5.0 (educational research; contact: project maintainers)"
+
+
+def build_pubmed_query(topic: str) -> str:
+    topic = re.sub(r"\s+", " ", topic).strip()
+    if not topic:
+        raise ValueError("A clinical topic is required")
+    # PubMed publication-type filters restrict results to indexed guideline records.
+    return f'(({topic}) AND ("Practice Guideline"[Publication Type] OR "Guideline"[Publication Type]))'
+
+
+def _text(node: ET.Element | None) -> str:
+    if node is None:
+        return ""
+    return re.sub(r"\s+", " ", " ".join(node.itertext())).strip()
+
+
+def _publication_date(article: ET.Element) -> str:
+    date_node = article.find(".//JournalIssue/PubDate")
+    if date_node is None:
+        date_node = article.find(".//PubDate")
+    if date_node is None:
+        return ""
+    year = _text(date_node.find("Year"))
+    month = _text(date_node.find("Month"))
+    day = _text(date_node.find("Day"))
+    if year and year.isdigit():
+        month_names = ("January", "February", "March", "April", "May", "June", "July", "August",
+                       "September", "October", "November", "December")
+        months = {name.lower(): f"{i:02d}" for i, name in enumerate(month_names, 1)}
+        months.update({name[:3].lower(): f"{i:02d}" for i, name in enumerate(month_names, 1)})
+        month_num = months.get(month.lower(), month.zfill(2) if month.isdigit() else "")
+        if month_num and day.isdigit():
+            return f"{year}-{month_num}-{day.zfill(2)}"
+        if month_num:
+            return f"{year}-{month_num}-01"
+        return f"{year}-01-01"
+    return _text(date_node.find("MedlineDate"))[:10]
+
+
+def parse_pubmed_xml(payload: bytes | str, *, accessed_at: str | None = None) -> list[dict[str, str]]:
+    root = ET.fromstring(payload)
+    accessed = accessed_at or dt.date.today().isoformat()
+    records: list[dict[str, str]] = []
+    for item in root.findall(".//PubmedArticle"):
+        citation = item.find(".//MedlineCitation")
+        article = citation.find("Article") if citation is not None else None
+        if article is None:
+            continue
+        pmid = _text(citation.find("PMID")) if citation is not None else ""
+        title = _text(article.find("ArticleTitle"))
+        if not pmid or not title:
+            continue
+        journal = _text(article.find("Journal/Title")) or "PubMed indexed record"
+        abstract_parts = []
+        abstract = article.find("Abstract")
+        if abstract is not None:
+            for part in abstract.findall("AbstractText"):
+                label = part.attrib.get("Label", "").strip()
+                value = _text(part)
+                if value:
+                    abstract_parts.append(f"{label}: {value}" if label else value)
+        doi = ""
+        for identifier in item.findall(".//ArticleId"):
+            if identifier.attrib.get("IdType", "").lower() == "doi":
+                doi = _text(identifier)
+                break
+        publication_types = [
+            _text(x) for x in article.findall("PublicationTypeList/PublicationType") if _text(x)
+        ]
+        pub_date = _publication_date(article)
+        records.append({
+            "guideline_id": f"pubmed:{pmid}",
+            "publisher": "PubMed (NCBI indexing service)",
+            "journal": journal,
+            "title": title,
+            "stable_url": f"https://pubmed.ncbi.nlm.nih.gov/{pmid}/",
+            "publication_date": pub_date,
+            "last_updated": "",
+            "accessed_at": accessed,
+            "version": f"PubMed PMID {pmid}",
+            "source_database": "PubMed",
+            "source_record_id": pmid,
+            "doi": doi,
+            "abstract": "\n".join(abstract_parts),
+            "source_label": "PubMed-indexed guideline citation; verify current version and recommendations at the issuing publisher",
+            "publication_types": "; ".join(publication_types),
+            # Intentionally no recommendation_text/strength_grade here.
+        })
+    return records
+
+
+def search_pubmed_guidelines(topic: str, *, limit: int = 25,
+                              get: Callable[..., bytes] = http_get,
+                              accessed_at: str | None = None) -> list[dict[str, str]]:
+    if limit < 1 or limit > 200:
+        raise ValueError("limit must be between 1 and 200")
+    query = build_pubmed_query(topic)
+    search_url = EUTILS + "/esearch.fcgi?" + urllib.parse.urlencode({
+        "db": "pubmed", "term": query, "retmode": "json", "retmax": str(limit),
+        "sort": "date",
+    })
+    search_data = json.loads(get(search_url, accept="application/json", user_agent=USER_AGENT))
+    ids = search_data.get("esearchresult", {}).get("idlist", [])
+    if not ids:
+        return []
+    fetch_url = EUTILS + "/efetch.fcgi?" + urllib.parse.urlencode({
+        "db": "pubmed", "id": ",".join(ids), "retmode": "xml",
+    })
+    return parse_pubmed_xml(get(fetch_url, accept="application/xml", user_agent=USER_AGENT),
+                             accessed_at=accessed_at)
+
+
+def main(argv: list[str] | None = None) -> int:
+    parser = argparse.ArgumentParser(description="Discover PubMed-indexed clinical practice guidelines")
+    parser.add_argument("--query", required=True, help="Clinical condition or topic, e.g. acute urinary retention")
+    parser.add_argument("--limit", type=int, default=25, help="Maximum citations to retrieve (1-200)")
+    parser.add_argument("--output", type=Path, required=True, help="Output JSONL file for ANKI guideline import")
+    args = parser.parse_args(argv)
+    try:
+        records = search_pubmed_guidelines(args.query, limit=args.limit)
+        args.output.parent.mkdir(parents=True, exist_ok=True)
+        args.output.write_text("".join(json.dumps(x, ensure_ascii=False) + "\n" for x in records), encoding="utf-8")
