+    "case_id": {"type": "string", "minLength": 1},
+    "asset_type": {"enum": ["figure", "table"]},
+    "label": {"type": "string"},
+    "caption": {"type": "string"},
+    "graphic_refs": {"type": "array", "items": {"type": "string"}},
+    "source_url": {"type": "string"},
+    "source_xml_sha256": {"type": "string", "minLength": 1},
