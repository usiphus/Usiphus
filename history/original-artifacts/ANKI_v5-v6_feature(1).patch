+    "oculoplastics": [r"\beyelid\b", r"\borbit\b", r"\borbital\b", r"\bptosis\b", r"\bchalazion\b", r"\bblephar"],
+    "strabismus": [r"\bstrabismus\b", r"\bamblyopia\b", r"\besotropia\b", r"\bexotropia\b"],
+    "neuro-ophthalmology": [r"\boptic neuritis\b", r"\boptic neuropathy\b", r"\boptic atrophy\b", r"\bpapilledema\b"],
+    "pediatric": [r"\bretinopathy of prematurity\b", r"\bamblyopia\b", r"\bretinoblastoma\b"],
+    "trauma": [r"\bocular trauma\b", r"\bopen globe\b", r"\bhyphema\b"],
