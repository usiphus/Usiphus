+# ---------------------------------------------------------------- tags & topics
+SUBTOPICS = {
+    "retina": [r"\bretin", r"\bmacula", r"\bmacular", r"\bvitreous\b", r"\bchoroid", r"\bchorioretin"],
+    "glaucoma": [r"\bglaucoma\b", r"\bintraocular pressure\b", r"\btrabeculectomy\b", r"\boptic disc\b"],
+    "cornea": [r"\bcornea", r"\bcorneal\b", r"\bkerat", r"\bcorneal ulcer\b"],
+    "uveitis": [r"\buveitis\b", r"\buveal\b", r"\biritis\b", r"\biridocyclitis\b"],
