+EXAM_FRONT_ORDER = ("presentation", "history", "exam", "workup")
+EXAM_BACK_ORDER = ("discussion", "conclusion", "tx", "outcome")
+EXAM_FULL_ORDER = EXAM_FRONT_ORDER + ("dx",) + EXAM_BACK_ORDER
+JOURNAL_FRONT_ORDER = ("chief", "hpi", "past", "exam", "lab", "imaging")
+JOURNAL_FRONT_FALLBACK = ("presentation", "case", "history", "workup")
+JOURNAL_BACK_ORDER = ("tx", "outcome", "discussion", "conclusion")
+JOURNAL_FULL_ORDER = (JOURNAL_FRONT_ORDER + JOURNAL_FRONT_FALLBACK + ("dx",) + JOURNAL_BACK_ORDER)
