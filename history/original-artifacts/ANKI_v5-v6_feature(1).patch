+    "cardiology": {"label": "Cardiology", "terms": ["cardiac", "heart", "myocardial", "cardiomyopathy", "coronary", "aortic", "atrial", "ventricular", "arrhythmia", "pericardial", "endocarditis", "valvular", "heart failure", "myocarditis"]},
