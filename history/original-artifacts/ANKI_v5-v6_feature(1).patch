+SECTION_LABELS = {"presentation": "Clinical presentation", "history": "History", "exam": "Examination", "workup": "Investigations", "dx": "Diagnosis", "discussion": "Discussion", "tx": "Treatment", "outcome": "Outcome", "conclusion": "Conclusion", "chief": "Chief complaint", "hpi": "History of present illness", "past": "Past medical & family history", "lab": "Laboratory findings", "imaging": "Imaging & pathology", "case": "Case presentation"}
