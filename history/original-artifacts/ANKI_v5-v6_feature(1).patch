+
+# ---------------------------------------------------------------- helpers
+def local(tag): return tag.rsplit("}", 1)[-1] if isinstance(tag, str) else ""
+def norm(s): return re.sub(r"\s+", " ", s or "").strip()
+def clean_ws(s):
+    if not s: return ""
+    s = re.sub(r"\s+", " ", s); s = re.sub(r"\s+([,.;:!?])", r"\1", s)
+    return s.strip()
+def clip(s, n):
+    s = norm(s)
+    if len(s) <= n: return s
+    cut = s[:n]; k = max(cut.rfind(". "), cut.rfind("; "))
+    cut = cut[:k + 1] if k > n * 0.5 else cut.rsplit(" ", 1)[0]
+    return cut.rstrip(",;:") + " …"
+def esc(s): return html.escape(s or "", quote=True) # quote=True prevents attribute injection
+def cloze_safe(s): return (s or "").replace("}}", "} }").replace("{{", "{ {")
+def stable_id(s): return int(hashlib.sha1(s.encode()).hexdigest()[:8], 16)
+def sanitize_tag(s): return re.sub(r"[^\w\-]+", "_", s or "").strip("_").lower()
+def clip_for_front(text, n=500): return clip(text, n) if text else ""
+
+# ---------------------------------------------------------------- highlight patterns
+HIGHLIGHT_PATTERNS = [
+    ("hl-finding", re.compile(r"\b(?:cherry[- ]red spot|macular star|hypopyon|hyphema|papilledema|macular edema|cystoid macular edema|retinal whitening|retinal detachment|rhegmatogenous retinal detachment|tractional retinal detachment|serous retinal detachment|subretinal fluid|subretinal hemorrhage|vitreous hemorrhage|vitreous cells|vitritis|relative afferent pupillary defect|RAPD|rubeosis iridis|iris neovascularization|band keratopathy|sunset glow fundus|keratic precipitates|posterior synechiae|optic disc cupping|optic disc pallor|disc swelling|neovascularization of the disc|NVD|NVE|corneal edema|corneal opacity|corneal infiltrate|snowbanking|bone[- ]spicule pigmentation|chorioretinal atrophy|cotton[- ]wool spots|hard exudates|dot[- ]blot hemorrhages|flame[- ]shaped hemorrhages|lattice degeneration|epiretinal membrane|vitreomacular traction|macular hole|proptosis|enophthalmos|phacodonesis|lens subluxation|lens dislocation|seidel sign|tyndall effect|kayser[- ]fleischer ring|lisch nodules|argyll robertson pupil|marcus gunn pupil|altitudinal defect|arcuate scotoma|central scotoma|bitemporal hemianopia|homonymous hemianopia|enlarged blind spot|posterior capsular opacification|choroidal effusion|choroidal neovascular membrane|retinal artery occlusion|retinal vein occlusion|central retinal artery occlusion|central retinal vein occlusion|branch retinal artery occlusion|branch retinal vein occlusion|amaurosis fugax|ST elevation|ST depression|wellens|brugada|torsades|long QT|short QT|hyperacute T waves|pathological Q waves|ventricular fibrillation|ventricular tachycardia|atrial fibrillation|atrial flutter|left bundle branch block|right bundle branch block|complete heart block|wenckebach|mobitz|left ventricular hypertrophy|right ventricular hypertrophy|takotsubo|pericardial effusion|cardiac tamponade|aortic stenosis|mitral regurgitation|holosystolic murmur|opening snap|ejection click|paradoxical splitting|jugular venous distension|hepatojugular reflux|kussmaul sign|pulsus paradoxus|electrical alternans|S3 gallop|S4 gallop|pedal edema|pitting edema|bibasilar crackles|babinski sign|upgoing plantar|pronator drift|nuchal rigidity|meningismus|kernig sign|brudzinski sign|glasgow coma scale|nihss|anisocoria|horner syndrome|internuclear ophthalmoplegia|wallenberg|weber syndrome|dysmetria|dysdiadochokinesia|intention tremor|cogwheel rigidity|lead pipe rigidity|pill rolling tremor|resting tremor|asterixis|myoclonus|chorea|athetosis|fasciculations|spasticity|hypotonia|hemiparesis|hemiplegia|paraparesis|hemisensory loss|aphasia|dysarthria|dysphagia|gaze palsy|gaze deviation|hemispatial neglect|apraxia|agnosia|status epilepticus|lhermitte sign|tinel sign|phalen sign|hyperreflexia|hyporeflexia|areflexia|clonus|spastic gait|ataxic gait|festinating gait|murphy sign|mcburney point|rovsing sign|psoas sign|obturator sign|blumberg sign|rebound tenderness|guarding|board like abdomen|caput medusae|spider angiomata|palmar erythema|hepatomegaly|splenomegaly|ascites|shifting dullness|fluid wave|coffee ground emesis|hematemesis|melena|hematochezia|steatorrhea|acholic stools|absent bowel sounds|perianal fistula|lead pipe colon|thumbprinting|apple core lesion|bird beak sign|double bubble sign|courvoisier sign|charcot triad|reynolds pentad|peritonitis|pneumoperitoneum|exophthalmos|pretibial myxedema|goiter|pemberton sign|kussmaul breathing|fruity breath|moon facies|buffalo hump|violaceous striae|salt craving|orthostatic hypotension|acanthosis nigricans|central obesity|galactorrhea|gynecomastia|chvostek sign|trousseau sign|car popedal spasm|gottron papules|heliotrope rash|shawl sign|mechanic hands|raynaud phenomenon|sclerodactyly|digital ulcers|calcinosis cutis|malar rash|discoid rash|photosensitivity|oral ulcers|nonerosive arthritis|anti dsDNA|anti sm|anti ro|anti la|anti rnp|anti scl 70|anti jo 1|anti ccp|rheumatoid factor positive|synovitis|joint effusion|dactylitis|sausage digit|enthesitis|sacroiliitis|swan neck deformity|boutonniere deformity|ulnar deviation|morning stiffness|erythema nodosum|erythema marginatum|koebner phenomenon|auspitz sign|nikolsky sign|darier sign|wickham striae|livedo reticularis|nail fold telangiectasia|purpura|petechiae|ecchymoses|b symptoms|night sweats|drenching night sweats|unexplained weight loss|lymphadenopathy|hepatosplenomegaly|circulating blasts|blast cells|leukemic blasts|teardrop cells|schistocytes|spherocytes|bite cells|target cells|basophilic stippling|howell jolly bodies|heinz bodies|auer rods|hypercellular marrow|hypocellular marrow|myelofibrosis|ring sideroblasts|pelger huet anomaly|hypersegmented neutrophils|dohle bodies|toxic granulation|extramedullary hematopoiesis|smudge cells|sezary cells|monoclonal spike|M protein|lytic bone lesions|osteolytic lesion|osteoblastic lesion|otorrhea|bullous myringitis|hemotympanum|tympanic membrane perforation|tympanic membrane retraction|septal perforation|nasal polyp|CSF rhinorrhea|tonsillar exudate|uvular deviation|hot potato voice|halitosis|postnasal drip|blunted affect|flat affect|labile affect|psychomotor retardation|psychomotor agitation|pressured speech|clanging|word salad|neologisms|flight of ideas|tangentiality|circumstantiality|hallucinations|delusion|catatonia|waxy flexibility|akathisia|dystonia|pseudoparkinsonism|tardive dyskinesia|anhedonia|avolition|alogia|suicidal ideation|self harm|bulging fontanelle|sunken fontanelle|failure to thrive|poor feeding|neonatal jaundice|kernicterus|apgar score|developmental delay|hypotonia|hypertonia|small for gestational age|large for gestational age|fundal height|fetal heart tones|placenta previa|placental abruption|cord prolapse|shoulder dystocia|fetal bradycardia|fetal tachycardia|late decelerations|variable decelerations|hegar sign|chadwick sign|goodell sign|crepitus|joint locking|giving way|mcMurray sign|lachman test|drawer sign|apprehension test|ballottement|fat pad sign|joint line tenderness|compartment syndrome|pulse deficit|seat belt sign|grey turner sign|cullen sign|positive fast|open fracture|closed fracture|neurovascular compromise)\b", re.I)),
+    ("hl-measure", re.compile(r"\b\d+(?:[./-]\d+)?\s*(?:mm\s*Hg|mmHg|mg/dL|g/dL|mEq/L|mmol/L|(?:[uµ]mol|nmol|pmol)/L|IU/(?:mL|L)|U/(?:mL|L)|ng/(?:mL|dL|L)|pg/(?:mL|dL|L)|(?:[uµ]g|mcg|mg|ng|pg)/(?:mL|dL|L)|cells?/(?:[uµ]L|mm3)|mm/(?:h|hr)|mL|L|dL|mm|cm|bpm|/min|dB|logMAR|diopters?)\b", re.I)),
+    ("hl-measure", re.compile(r"\b(?:20/\d+|[0-6]/\d+|CF|HM|LP|NLP|count(?:ing)?\s+fingers|hand[\s-]?motion|light\s+perception|no\s+light\s+perception|logMAR\s*[-\d.]+|[-+]?\d+(?:\.\d+)?\s*D\b)\b", re.I)),
+    ("hl-eye", re.compile(r"\b(?:OD|OS|OU|o\.d\.|o\.s\.|o\.u\.|right\s+(?:eye|orbit|cornea|retina|optic\s+nerve|pupil|lens)|left\s+(?:eye|orbit|cornea|retina|optic\s+nerve|pupil|lens)|both\s+eyes|bilateral|unilateral)\b", re.I)),
+    ("hl-demo", re.compile(r"\b\d{1,3}[- ](?:year|yr|month|week|day)s?[- ]old\s+(?:male|female|man|woman|boy|girl|patient|infant|child|neonate|adult|elderly)\b", re.I)),
+    ("hl-time", re.compile(r"\b(?:for|over|during|after|before|within|at)\s+\d+\s+(?:second|minute|hour|day|week|month|year)s?\b", re.I)),
+    ("hl-time", re.compile(r"\b\d+\s+(?:second|minute|hour|day|week|month|year)s?\s+(?:ago|duration|previously|prior|later|earlier|history)\b", re.I)),
+    ("hl-status", re.compile(r"\b(?:mild|moderate|severe|marked|profound|acute|chronic|sudden|gradual|progressive|rapidly\s+progressive|exacerbation|deterioration|improvement|resolved|persistent|recurrent|worsening|improving|stable|elevated|increased|decreased|reduced|abnormal)\b", re.I)),
+    ("hl-drug", re.compile(r"\b(?:timolol|dorzolamide|brimonidine|latanoprost|bimatoprost|travoprost|pilocarpine|acetazolamide|mannitol|prednisolone|prednisone|dexamethasone|methylprednisolone|bevacizumab|ranibizumab|aflibercept|faricimab|pegaptanib|vancomycin|ceftazidime|amikacin|voriconazole|methotrexate|cyclophosphamide|rituximab|infliximab|tocilizumab|adalimumab|mycophenolate|azathioprine|tacrolimus|cyclosporine|aspirin|clopidogrel|warfarin|heparin|apixaban|rivaroxaban|insulin|metformin|atorvastatin|rosuvastatin)\b", re.I)),
+]
+
+def enrich(text):
+    text = text or ""
+    if not text: return ""
+    spans = []
+    for cls, pat in HIGHLIGHT_PATTERNS:
+        for m in pat.finditer(text):
+            if m.start() == m.end(): continue
+            spans.append((m.start(), m.end(), cls))
+    if not spans: return esc(text)
+    spans.sort(key=lambda t: (t[0], -(t[1] - t[0])))
+    resolved = []; last_end = -1
+    for s, e, cls in spans:
+        if s < last_end: continue
+        resolved.append((s, e, cls)); last_end = e
+    out = []; last = 0
+    for s, e, cls in resolved:
+        if s > last: out.append(esc(text[last:s]))
+        out.append('<span class="' + cls + '">' + esc(text[s:e]) + '</span>')
+        last = e
+    if last < len(text): out.append(esc(text[last:]))
+    return "".join(out)
+
+# ---------------------------------------------------------------- JATS parsing
+SECTION_PATTERNS = {
+    "presentation": r"presentation|clinical presentation|case presentation|case report|case summary|case description|initial presentation|^clinical case\b",
