+    "hematology": {"label": "Hematology", "terms": ["anemia", "anaemia", "thrombocytopenia", "coagulopathy", "hemophilia", "haemophilia", "sickle cell", "thalassemia", "leukemia", "leukaemia", "lymphoma", "myeloma", "hematologic"]},
