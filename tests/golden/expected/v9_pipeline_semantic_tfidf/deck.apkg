{
  "deck": {
    "id": 119311872,
    "name": "Synthetic Deck"
  },
  "fake_genanki": "JSON stand-in for an .apkg file",
  "model": {
    "fields": [
      "Prompt",
      "Answer",
      "Options",
      "CorrectOption",
      "LearningObjective",
      "Tags",
      "CardID",
      "References",
      "Rubric",
      "EvidenceStatus",
      "BasicLayout",
      "MCQLayout",
      "ClinicalCaseLayout",
      "VivaLayout",
      "OSCELayout",
      "EvidenceExcerpt"
    ],
    "id": 1998908454,
    "name": "Usiphus V9 Medical Model",
    "templates": [
      {
        "afmt": "{{#BasicLayout}}{{FrontSide}}<hr id=\"answer\"><section class=\"answer\"><b>Answer</b><br>{{Answer}}</section>{{#CorrectOption}}<section><b>Correct option:</b> {{CorrectOption}}</section>{{/CorrectOption}}{{#LearningObjective}}<section><b>Learning objective:</b> {{LearningObjective}}</section>{{/LearningObjective}}{{#Rubric}}<section><b>Marking checklist</b><ul>{{Rubric}}</ul></section>{{/Rubric}}{{#EvidenceExcerpt}}<blockquote class=\"source-evidence\"><b>Source excerpt (unverified)</b><br>{{EvidenceExcerpt}}</blockquote>{{/EvidenceExcerpt}}{{#References}}<small class=\"references\">{{References}}</small>{{/References}}<small class=\"evidence\">Evidence status: {{EvidenceStatus}}</small><div class=\"metadata\">{{Tags}} · {{CardID}}</div>{{/BasicLayout}}",
        "name": "Rapid recall",
        "qfmt": "{{#BasicLayout}}<main class=\"usiphus basic\"><header>Rapid recall</header>{{Prompt}}</main>{{/BasicLayout}}"
      },
      {
        "afmt": "{{#MCQLayout}}{{FrontSide}}<hr id=\"answer\"><section class=\"answer\"><b>Answer</b><br>{{Answer}}</section>{{#CorrectOption}}<section><b>Correct option:</b> {{CorrectOption}}</section>{{/CorrectOption}}{{#LearningObjective}}<section><b>Learning objective:</b> {{LearningObjective}}</section>{{/LearningObjective}}{{#Rubric}}<section><b>Marking checklist</b><ul>{{Rubric}}</ul></section>{{/Rubric}}{{#EvidenceExcerpt}}<blockquote class=\"source-evidence\"><b>Source excerpt (unverified)</b><br>{{EvidenceExcerpt}}</blockquote>{{/EvidenceExcerpt}}{{#References}}<small class=\"references\">{{References}}</small>{{/References}}<small class=\"evidence\">Evidence status: {{EvidenceStatus}}</small><div class=\"metadata\">{{Tags}} · {{CardID}}</div>{{/MCQLayout}}",
        "name": "Single best answer",
        "qfmt": "{{#MCQLayout}}<main class=\"usiphus mcq\"><header>Single best answer</header>{{Prompt}}{{#Options}}<hr><ol>{{Options}}</ol>{{/Options}}</main>{{/MCQLayout}}"
      },
      {
        "afmt": "{{#ClinicalCaseLayout}}{{FrontSide}}<hr id=\"answer\"><section class=\"answer\"><b>Answer</b><br>{{Answer}}</section>{{#CorrectOption}}<section><b>Correct option:</b> {{CorrectOption}}</section>{{/CorrectOption}}{{#LearningObjective}}<section><b>Learning objective:</b> {{LearningObjective}}</section>{{/LearningObjective}}{{#Rubric}}<section><b>Marking checklist</b><ul>{{Rubric}}</ul></section>{{/Rubric}}{{#EvidenceExcerpt}}<blockquote class=\"source-evidence\"><b>Source excerpt (unverified)</b><br>{{EvidenceExcerpt}}</blockquote>{{/EvidenceExcerpt}}{{#References}}<small class=\"references\">{{References}}</small>{{/References}}<small class=\"evidence\">Evidence status: {{EvidenceStatus}}</small><div class=\"metadata\">{{Tags}} · {{CardID}}</div>{{/ClinicalCaseLayout}}",
        "name": "Clinical case",
        "qfmt": "{{#ClinicalCaseLayout}}<main class=\"usiphus case\"><header>Clinical case</header><b>Clinical case</b><div>{{Prompt}}</div></main>{{/ClinicalCaseLayout}}"
      },
      {
        "afmt": "{{#VivaLayout}}{{FrontSide}}<hr id=\"answer\"><section class=\"answer\"><b>Answer</b><br>{{Answer}}</section>{{#CorrectOption}}<section><b>Correct option:</b> {{CorrectOption}}</section>{{/CorrectOption}}{{#LearningObjective}}<section><b>Learning objective:</b> {{LearningObjective}}</section>{{/LearningObjective}}{{#Rubric}}<section><b>Marking checklist</b><ul>{{Rubric}}</ul></section>{{/Rubric}}{{#EvidenceExcerpt}}<blockquote class=\"source-evidence\"><b>Source excerpt (unverified)</b><br>{{EvidenceExcerpt}}</blockquote>{{/EvidenceExcerpt}}{{#References}}<small class=\"references\">{{References}}</small>{{/References}}<small class=\"evidence\">Evidence status: {{EvidenceStatus}}</small><div class=\"metadata\">{{Tags}} · {{CardID}}</div>{{/VivaLayout}}",
        "name": "Viva",
        "qfmt": "{{#VivaLayout}}<main class=\"usiphus viva\"><header>Viva</header><b>Oral examination</b><div>{{Prompt}}</div></main>{{/VivaLayout}}"
      },
      {
        "afmt": "{{#OSCELayout}}{{FrontSide}}<hr id=\"answer\"><section class=\"answer\"><b>Answer</b><br>{{Answer}}</section>{{#CorrectOption}}<section><b>Correct option:</b> {{CorrectOption}}</section>{{/CorrectOption}}{{#LearningObjective}}<section><b>Learning objective:</b> {{LearningObjective}}</section>{{/LearningObjective}}{{#Rubric}}<section><b>Marking checklist</b><ul>{{Rubric}}</ul></section>{{/Rubric}}{{#EvidenceExcerpt}}<blockquote class=\"source-evidence\"><b>Source excerpt (unverified)</b><br>{{EvidenceExcerpt}}</blockquote>{{/EvidenceExcerpt}}{{#References}}<small class=\"references\">{{References}}</small>{{/References}}<small class=\"evidence\">Evidence status: {{EvidenceStatus}}</small><div class=\"metadata\">{{Tags}} · {{CardID}}</div>{{/OSCELayout}}",
        "name": "OSCE station",
        "qfmt": "{{#OSCELayout}}<main class=\"usiphus osce\"><header>OSCE station</header><b>OSCE station</b><div>{{Prompt}}</div></main>{{/OSCELayout}}"
      }
    ]
  },
